<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- If the compiler ever emits to project-local 'generated/', do not compile those files. -->
    <Compile Remove="generated/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shalimar.Runtime" />
    <PackageReference Include="Shalimar.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Shalimar.MSBuildTasks" PrivateAssets="all" />
    <PackageReference Include="Shalimar.RoslynAnalyzer" PrivateAssets="all" />
    <PackageReference Include="Shalimar.Vite" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Shared/runtime/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

