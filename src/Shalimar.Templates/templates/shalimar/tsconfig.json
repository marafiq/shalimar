{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@generated/*": ["./Generated/*"],
      "@shalimar/runtime": ["./Shared/runtime"],
      "@shalimar/runtime/*": ["./Shared/runtime/*"]
    }
  },
  "include": ["Client", "Features", "Generated", "Shared"]
}
