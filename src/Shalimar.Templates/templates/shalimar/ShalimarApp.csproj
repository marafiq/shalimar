<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Template is standalone, not using repo's CPM -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Enable source generator output to disk for TypeScript extraction -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shalimar.Runtime" Version="1.0.0-local" />
    <PackageReference Include="Shalimar.Vite" Version="1.0.0-local" />
    <PackageReference Include="Shalimar.SourceGenerator" Version="1.0.0-local" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Shalimar.RoslynAnalyzer" Version="1.0.0-local" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Shalimar.MSBuildTasks" Version="1.0.0-local" />
  </ItemGroup>
</Project>
