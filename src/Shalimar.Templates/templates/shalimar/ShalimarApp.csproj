<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Required so MSBuild can read generator outputs and extract embedded TS into Generated/ -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shalimar.Runtime" />
    <PackageReference Include="Shalimar.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Shalimar.MSBuildTasks" PrivateAssets="all" />
    <PackageReference Include="Shalimar.RoslynAnalyzer" PrivateAssets="all" />
    <PackageReference Include="Shalimar.Vite" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Shared/runtime/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

